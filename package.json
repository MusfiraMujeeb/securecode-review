{
  "name": "securecode-review",
  "displayName": "SecureCode Review",
  "description": "Detects JS/TS security anti-patterns with one-click fixes.",
  "publisher": "MusfiraMujeeb",
  "repository": {
    "type": "git",
    "url": "https://github.com/MusfiraMujeeb/securecode-review.git"
  },
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Security"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "securecode.scanCurrentFile",
        "title": "SecureCode: Scan Current File"
      },
      {
        "command": "securecode.helloWorld",
        "title": "SecureCode: Hello World"
      }
    ],
    "configuration": {
      "title": "SecureCode Review",
      "properties": {
        "securecode.enableEvalCheck": {
          "type": "boolean",
          "default": true,
          "description": "Warn when eval() is used (arbitrary code execution risk)."
        },
        "securecode.enableJwtCheck": {
          "type": "boolean",
          "default": true,
          "description": "Warn when JWT is signed without an expiresIn option."
        },
        "securecode.enableCorsCheck": {
          "type": "boolean",
          "default": true,
          "description": "Warn when CORS is configured with a wildcard or no origin."
        },
        "securecode.enableSecretCheck": {
          "type": "boolean",
          "default": true,
          "description": "Warn when hardcoded secrets are detected."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "20.x",
    "typescript-eslint": "^8.0.0",
    "eslint": "^9.0.0",
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.6.0"
  }
}